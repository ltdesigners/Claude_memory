# API Key privada generada en GoHighLevel:
# Sub-cuenta (Location) > Settings > Business Info > API Key (Private Integration)
GHL_API_KEY=

# ID de la sub-cuenta (Location) a la que pertenece la API Key.
# Se encuentra en Settings > Business Info, campo "Location ID".
GHL_LOCATION_ID=

# Opcional: versión de la API de GoHighLevel (no suele cambiarse).
GHL_API_VERSION=2021-07-28

# Opcional: URL base de la API (no suele cambiarse).
GHL_BASE_URL=https://services.leadconnectorhq.com
