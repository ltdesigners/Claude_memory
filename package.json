{
  "name": "ghl-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that exposes GoHighLevel (LeadConnector) API v2 data to Claude: contacts, opportunities, pipelines, workflows, calendars, appointments, conversations and users.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ghl-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
